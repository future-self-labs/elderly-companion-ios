    "Noah": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah"
          }
        }
      }
    },
    "Noah begint hier zelf niet over.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah begint hier zelf niet over."
          }
        }
      }
    },
    "Noah belt dan elke gekozen dag om een goedemorgen te wensen en de dag door te nemen.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah belt dan elke gekozen dag om een goedemorgen te wensen en de dag door te nemen."
          }
        }
      }
    },
    "Noah belt elke ochtend": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah belt elke ochtend"
          }
        }
      }
    },
    "Noah gebruikt deze naam in de gesprekken.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah gebruikt deze naam in de gesprekken."
          }
        }
      }
    },
    "Noah geeft signalen door om je te helpen opletten. Het is geen medisch oordeel. Twijfel je, overleg dan met de huisarts.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah geeft signalen door om je te helpen opletten. Het is geen medisch oordeel. Twijfel je, overleg dan met de huisarts."
          }
        }
      }
    },
    "Noah helpt u herinneren, naast wat u al gebruikt, zoals uw medicijndoos of de kalender.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah helpt u herinneren, naast wat u al gebruikt, zoals uw medicijndoos of de kalender."
          }
        }
      }
    },
    "Noah herkent dit nummer als er gebeld wordt, en belt naar dit nummer voor herinneringen en het ochtendgesprek.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah herkent dit nummer als er gebeld wordt, en belt naar dit nummer voor herinneringen en het ochtendgesprek."
          }
        }
      }
    },
    "Noah instellen": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah instellen"
          }
        }
      }
    },
    "Noah is actief voor %@": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is actief voor %@"
          }
        }
      }
    },
    "Noah is actief voor %@.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is actief voor %@."
          }
        }
      }
    },
    "Noah is een warme metgezel om mee te praten. Voor waardig ouder worden, en gemoedsrust voor de familie.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is een warme metgezel om mee te praten. Voor waardig ouder worden, en gemoedsrust voor de familie."
          }
        }
      }
    },
    "Noah is een warme metgezel voor je vader, moeder of naaste. Iemand die luistert, onthoudt en er altijd is, ook als jij er even niet bent. Want eenzaamheid hoort niet bij ouder worden.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah is een warme metgezel voor je vader, moeder of naaste. Iemand die luistert, onthoudt en er altijd is, ook als jij er even niet bent. Want eenzaamheid hoort niet bij ouder worden."
          }
        }
      }
    },
    "Noah kan een extra geheugensteuntje geven: voor een afspraak, een verjaardag, medicijnen of een vast rondje wandelen.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah kan een extra geheugensteuntje geven: voor een afspraak, een verjaardag, medicijnen of een vast rondje wandelen."
          }
        }
      }
    },
    "Noah laat het je weten als er iets lijkt te spelen, zoals een sombere stemming, een hulpvraag of een mogelijk oplichtingstelefoontje.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah laat het je weten als er iets lijkt te spelen, zoals een sombere stemming, een hulpvraag of een mogelijk oplichtingstelefoontje."
          }
        }
      }
    },
    "Noah maakt een praatje, haalt herinneringen op, schrijft het levensverhaal op en geeft een extra geheugensteuntje, van afspraken tot verjaardagen. Gewoon door te praten, via de app of een gewoon telefoonnummer. Noah is een AI, geen mens, en zegt dat ook eerlijk.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah maakt een praatje, haalt herinneringen op, schrijft het levensverhaal op en geeft een extra geheugensteuntje, van afspraken tot verjaardagen. Gewoon door te praten, via de app of een gewoon telefoonnummer. Noah is een AI, geen mens, en zegt dat ook eerlijk."
          }
        }
      }
    },
    "Noah merkte iets op": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah merkte iets op"
          }
        }
      }
    },
    "Noah neemt dit mee in de volgende gesprekken.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah neemt dit mee in de volgende gesprekken."
          }
        }
      }
    },
    "Noah vraagt altijd eerst toestemming": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah vraagt altijd eerst toestemming"
          }
        }
      }
    },
    "Noah zegt standaard “u”. Kies “jij” als dat vertrouwder voelt.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah zegt standaard “u”. Kies “jij” als dat vertrouwder voelt."
          }
        }
      }
    },
    "Noah's herinneringen zijn een extra geheugensteuntje, naast wat er al is (zoals een medicijndoos, de apotheek, thuiszorg of je eigen berichtjes). Noah houdt geen medicijngebruik bij en is geen medisch hulpmiddel. Vertrouw er niet als enige op: een gemist gesprek of een storing kan altijd.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noah's herinneringen zijn een extra geheugensteuntje, naast wat er al is (zoals een medicijndoos, de apotheek, thuiszorg of je eigen berichtjes). Noah houdt geen medicijngebruik bij en is geen medisch hulpmiddel. Vertrouw er niet als enige op: een gemist gesprek of een storing kan altijd."
          }
        }
      }
    },

    },
    "%@ doet mee aan de bètatest: Noah is gratis en meteen actief." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ doet mee aan de bètatest: Noah is gratis en meteen actief."
